# Banco de dados PostgreSQL
DATABASE_URL=postgresql://crm:password@localhost:5432/crm

# NextAuth — gere com: openssl rand -base64 32 (mínimo 32 caracteres)
NEXTAUTH_SECRET=gere-um-valor-aleatorio-de-no-minimo-32-caracteres
NEXTAUTH_URL=https://seu-dominio.com

# SMTP para envio de emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=smtp-password
SMTP_FROM=no-reply@seu-dominio.com

# Seed do banco — use uma senha forte (mínimo 12 caracteres, letras, números e símbolos)
SEED_ADMIN_EMAIL=admin@seu-dominio.com
SEED_ADMIN_PASSWORD=TrocaPorUmaSenhaForte!2024

# Docker Compose
POSTGRES_PASSWORD=senha-forte-para-o-banco
